id=adb_root
name=ADB Root
version=v2.0
versionCode=2
author=Denis Efremov (@evdenis)
description=Allows to "adb root" regardless of props settings and skips usb keys auth. Kind of "adbd Insecure" as a Magisk Module. Supports arm64, arm, x86, x86_64. Android 9/10 only.
updateJson=https://github.com/evdenis/adb_root/releases/latest/download/update.json
